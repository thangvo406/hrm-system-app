def update_target_bundle_id(target_name:, plist_path:, bundle_id:)
  require 'xcodeproj'

  project_path = "../CoopUse.xcodeproj"

  puts "🔧 Updating target '#{target_name}' with bundle ID '#{bundle_id}'"

  # Open Xcode project
  project = Xcodeproj::Project.open(project_path)
  target = project.targets.find { |t| t.name == target_name }

  if target.nil?
    UI.user_error!("❌ Target '#{target_name}' not found in #{project_path}")
  end

  # Update build settings
  target.build_configurations.each do |config|
    config.build_settings['PRODUCT_BUNDLE_IDENTIFIER'] = bundle_id
  end

  project.save
  UI.success("✅ Updated PRODUCT_BUNDLE_IDENTIFIER for target '#{target_name}'")

  # Optionally update Info.plist too
  update_info_plist(
    plist_path: plist_path,
    app_identifier: bundle_id
  )
end


def prepare_package(options)
  ENV["PATH"] = "#{ENV["HOME"]}/.nvm/versions/node/v20.9.0/bin:/usr/local/bin:#{ENV["PATH"]}"
  sh "cp ../../../../../../CoopUse/yarn.lock ../../yarn.lock"
  versionCode = options[:version_number]
  increment_version_number(
    version_number: versionCode,      # specify specific version number (optional, omitting it increments patch version number)
    xcodeproj: "./CoopUse.xcodeproj"  # (optional, you must specify the path to your main Xcode project if it is not in the project root directory)
  )
  sh "yarn install --no-immutable"
  # cocoapods(
  #   clean_install: true,
  #   podfile: "./Podfile",
  #   silent: true,
  #   try_repo_update_on_error: true,
  # )
  sh "yarn pod"

  sh "rm -rf ../../ios/.xcode.env.local"
  sh "cp ../../../../../../AuthKey_ZPCY58L4X5.p8 ../../ios/AuthKey_ZPCY58L4X5.p8"
  return versionCode
end


def send_message_success(branchName, buildNumber, message = "App successfully released to AppCenter")
  post_teams_card(
    title: "App build successfully",
    message: message,
    facts:[
      {
        "name"=>"App",
        "value"=>"i-School",
     },
      {
        "name"=>"Branch",
        "value"=>"#{branchName}",
     },
      {
        "name"=>"Platform",
        "value"=>"iOS"
      },
      {
          "name"=>"Build number",
          "value"=>"#{buildNumber}",
      },
    ]
  )
end
