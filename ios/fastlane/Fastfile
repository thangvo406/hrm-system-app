# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane
require('dotenv')
require 'xcodeproj'
require 'base64'
require 'digest'
require 'fileutils'
require 'shellwords'

# Dotenv.load './Appfile'

default_platform(:ios)

# Thư mục ios/ và repo root, tính từ vị trí Fastfile (ios/fastlane).
# Dùng hằng số thay vì đường dẫn tương đối vì cwd của Ruby (ios/) khác cwd của
# action `sh` (ios/fastlane) — trộn hai loại này là nguồn lỗi kinh điển.
IOS_DIR = File.expand_path('..', __dir__)
REPO_ROOT = File.expand_path('../..', __dir__)

# Thư mục chứa secret trên máy local (env file, yarn.lock, AuthKey .p8).
# Trên GitHub Actions runner thư mục này không tồn tại nên mọi thao tác copy đều
# được bỏ qua: env file đã được commit trong repo, còn AuthKey .p8 do
# resolve_api_key_path ghi ra từ secret APP_STORE_CONNECT_API_KEY_BASE64.
LOCAL_SECRETS_DIR = File.expand_path('../../../../../..', __dir__)

platform :ios do
  desc "Build IPA dev và upload lên TestFlight"
  lane :beta do |options|
    prefixAppName = "CoopUse_DEV_v"
    # Dotenv.overload '../../env/.dev'
    branchName = resolve_branch_name(options)
    # Resolve version/build sớm để thông báo "start" có đủ thông tin, và để
    # nhánh rescue luôn có biến hợp lệ dù lỗi xảy ra ở bất kỳ đâu.
    versionCode = resolve_version_number(options)
    build = nil

    begin
      UI.message("--- BẮT ĐẦU BUILD IPA DEV & UPLOAD TESTFLIGHT ---")
      postNotifyMessage("start", branchName, versionCode, nil)

      # Validate credential App Store Connect TRƯỚC pod install: KEY_ID/ISSUER_ID
      # và .p8 không phụ thuộc env file hay Pods, nên secret sai sẽ fail trong
      # vài giây thay vì sau ~10 phút build.
      api_key_path = resolve_api_key_path
      puts IOS_DIR
      copy_local_secret(File.join(LOCAL_SECRETS_DIR, 'CoopUse', '.dev'), "#{REPO_ROOT}/env/.dev")
      # react-native-config reads the env file via /tmp/envfile (highest priority)
      # then ENVFILE. xcodebuild does not run scheme pre-actions, so set both here
      # to make the gym build deterministic. This must happen BEFORE
      # prepare_package: it runs pod install, and the Podfile generates ios/.env
      # and injects it into the xcconfig based on this selection.
      select_env_file("env/.dev")

      # Toàn bộ phần bắt tay App Store Connect chạy TRƯỚC pod install: nó chỉ
      # cần env file (vừa select ở trên) và .p8, không đụng gì tới Pods. Đặt ở
      # đây thì lỗi credential lộ ra sau ~40 giây thay vì sau ~10 phút.
      appId = resolve_ios_app_id
      appName = "#{prefixAppName}#{versionCode}.ipa"
      puts "api_key_path => #{api_key_path}"
      puts "appId => #{appId}"
      puts "KEY_ID => #{ENV["KEY_ID"]}"
      puts "ISSUER_ID => #{ENV["ISSUER_ID"]}"
      api_key = app_store_connect_api_key(
        key_id: ENV["KEY_ID"],
        issuer_id: ENV["ISSUER_ID"],
        key_filepath: api_key_path,
        # Apple từ chối token có exp quá 20 phút (1200s) so với giờ của Apple.
        # Dùng đúng 1200 là sát mép: runner lệch giờ vài giây là token thành
        # "quá 20 phút" và bị trả về "Authentication credentials are missing or
        # invalid". 500 là default của fastlane, thừa sức cho một lần build.
        duration: 500,
        in_house: false # optional but may be required if using match/sigh
      )

      build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: appId,
        version: versionCode,
        )
      if build.nil?
        build = resolve_build_number(options)
      else
        build = build + 1
      end

      puts "versionCode => #{versionCode}"
      puts "build => #{build}"

      # Từ đây trở xuống mới cần Pods / node_modules.
      prepare_package(options)

    #  puts "Endpoint => #{ENV["BASE_URL"]}"

      set_project_version(version_number: versionCode, build_number: build)

      # 1. Ép buộc bật Automatic Signing trong Xcode Project file
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "#{IOS_DIR}/CoopUse.xcodeproj" # Đường dẫn tới file xcodeproj của bạn
      )

      # 2. Trên CI: tạo keychain tạm + nạp certificate distribution (nếu có secret).
      # Không có cert thì dựa hoàn toàn vào -allowProvisioningUpdates + API key.
      setup_signing

      # 3. Chạy lệnh Build
      # xcodebuild bỏ qua scheme pre-actions, nên phải tự sinh
      # ios/.env + ios/tmp.xcconfig ở đây trước khi gym đọc build settings.
      sh "#{REPO_ROOT.shellescape}/scripts/generate-ios-env.sh"
      gym(
        scheme: "CoopUse",
        clean: true,
        workspace: "#{IOS_DIR}/CoopUse.xcworkspace",
        export_method: "app-store",
        output_directory: "#{IOS_DIR}/builds",
        output_name: appName,
        silent: true,
        # Cho phép xcodebuild tự tạo/tải provisioning profile qua App Store Connect
        # API key — bắt buộc khi dùng automatic signing trên runner sạch.
        xcargs: provisioning_xcargs(api_key_path)
      )

      export_ipa_output(appName)

      pilot(
        api_key: api_key,
        app_identifier: appId,
        changelog: "Dev => #{branchName}",
        ipa: "#{IOS_DIR}/builds/#{appName}")

      postNotifyMessage("success", branchName, versionCode, build)
      UI.success("🎉 Đã build & upload thành công bản #{versionCode} (build #{build}) lên TestFlight!")
    rescue => e
      postNotifyMessage("error", branchName, versionCode, build)
      UI.error("❌ Build/upload TestFlight thất bại: #{e.message}")
      raise
    end
  end

  desc "Build IPA production và upload lên TestFlight"
  lane :release do |options|
    prefixAppName = "CoopUse_PRD_v"
    branchName = resolve_branch_name(options)
    # Xem lane beta: resolve sớm để "start" có thông tin và rescue luôn an toàn.
    versionCode = resolve_version_number(options)
    build = nil

    begin
      UI.message("--- BẮT ĐẦU BUILD IPA PROD & UPLOAD TESTFLIGHT ---")
      postNotifyMessage("start", branchName, versionCode, nil)

      # Xem lane beta: validate credential App Store Connect trước pod install.
      api_key_path = resolve_api_key_path

      copy_local_secret(File.join(LOCAL_SECRETS_DIR, 'CoopUse', '.prod'), "#{REPO_ROOT}/env/.prod")
      # See beta lane: select the env before prepare_package runs pod install,
      # otherwise the xcconfig gets env/.dev values while JS gets env/.prod ones.
      select_env_file("env/.prod")
      copy_local_secret(File.join(LOCAL_SECRETS_DIR, 'CoopUse', 'GoogleService-Pro.plist'), "#{IOS_DIR}/GoogleService-Info.plist")

      puts "Endpoint => #{ENV["BASE_URL"]}"

      # Xem lane beta: cụm App Store Connect chạy trước pod install.
      appId = resolve_ios_app_id
      appName = "#{prefixAppName}#{versionCode}.ipa"
      puts "api_key_path => #{api_key_path}"
      puts "appId => #{appId}"

      api_key = app_store_connect_api_key(
        key_id: ENV["KEY_ID"],
        issuer_id: ENV["ISSUER_ID"],
        key_filepath: api_key_path,
        # Apple từ chối token có exp quá 20 phút (1200s) so với giờ của Apple.
        # Dùng đúng 1200 là sát mép: runner lệch giờ vài giây là token thành
        # "quá 20 phút" và bị trả về "Authentication credentials are missing or
        # invalid". 500 là default của fastlane, thừa sức cho một lần build.
        duration: 500,
        in_house: false # optional but may be required if using match/sigh
      )

      build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: appId,
        version: versionCode,
      )

      if build.nil?
        build = resolve_build_number(options)
      else
        build = build + 1
      end

      puts "versionCode => #{versionCode}"
      puts "build => #{build}"

      # Từ đây trở xuống mới cần Pods / node_modules.
      prepare_package(options)

      # update_notification_service_id(appId)

      # Update main app target
      update_target_bundle_id(
        target_name: "CoopUse",
        plist_path: "#{IOS_DIR}/CoopUse/Info.plist",
        bundle_id: appId
      )

      # Update Notification Service target
      update_target_bundle_id(
        target_name: "CoopUseNotificationService",
        plist_path: "#{IOS_DIR}/CoopUseNotificationService/Info.plist",
        bundle_id: "#{appId}.CoopUseNotificationService"
      )

      set_project_version(version_number: versionCode, build_number: build)

      # 1. Ép buộc bật Automatic Signing trong Xcode Project file
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "#{IOS_DIR}/CoopUse.xcodeproj" # Đường dẫn tới file xcodeproj của bạn
      )

      # 2. Keychain tạm + certificate cho runner (xem lane beta).
      setup_signing

      # 3. Chạy lệnh Build
      # xcodebuild bỏ qua scheme pre-actions, nên phải tự sinh
      # ios/.env + ios/tmp.xcconfig ở đây trước khi gym đọc build settings.
      sh "#{REPO_ROOT.shellescape}/scripts/generate-ios-env.sh"
      gym(
        scheme: "CoopUse",
        clean: true,
        workspace: "#{IOS_DIR}/CoopUse.xcworkspace",
        export_method: "app-store",
        output_directory: "#{IOS_DIR}/builds",
        output_name: appName,
        silent: true,
        xcargs: provisioning_xcargs(api_key_path)
      )

      export_ipa_output(appName)

      pilot(
        api_key: api_key,
        app_identifier: appId,
        changelog: "PROD => #{branchName}",
        ipa: "#{IOS_DIR}/builds/#{appName}")

      postNotifyMessage("success", branchName, versionCode, build)
      UI.success("🎉 Đã build & upload thành công bản #{versionCode} (build #{build}) lên TestFlight!")
    rescue => e
      postNotifyMessage("error", branchName, versionCode, build)
      UI.error("❌ Build/upload TestFlight thất bại: #{e.message}")
      raise
    end
  end
end

# ---------------------------------------------------------------------------
# Helpers — CI / local
# ---------------------------------------------------------------------------

# Copy file secret từ máy local. Trên CI runner file nguồn không tồn tại nên
# bỏ qua: file đích đã được workflow decode từ GitHub secrets.
def copy_local_secret(source, destination)
  unless File.exist?(source)
    UI.important("Bỏ qua copy #{source} — không tìm thấy (bình thường trên CI).")
    return false
  end

  FileUtils.mkdir_p(File.dirname(destination))
  FileUtils.cp(source, destination)
  UI.message("Đã copy #{source} → #{destination}")
  true
end

# Chọn env file cho toàn bộ build (react-native-config + xcconfig + Fastfile).
# /tmp/envfile ưu tiên cao hơn ENVFILE trong ReadDotEnv.rb nên phải set cả hai.
def select_env_file(env_file)
  env_path = File.join(REPO_ROOT, env_file)
  unless File.exist?(env_path)
    UI.user_error!("Không tìm thấy #{env_path}. File này được commit trong repo — kiểm tra .gitignore có đang loại nó ra không.")
  end

  File.write('/tmp/envfile', "#{env_file}\n")
  ENV["ENVFILE"] = env_file
  Dotenv.overload(env_path)
end

# Version/build number: ưu tiên tham số lane, sau đó biến môi trường do
# GitHub Actions set (VERSION_NUMBER / BUILD_NUMBER), cuối cùng là default.
def resolve_version_number(options)
  version = options[:version_number] || ENV['VERSION_NUMBER']
  UI.user_error!("Thiếu version number: truyền version_number: hoặc set VERSION_NUMBER.") if version.nil? || version.to_s.empty?
  version.to_s
end

def resolve_build_number(options)
  build = options[:build_number] || ENV['BUILD_NUMBER'] || 1
  build.to_i
end

def resolve_branch_name(options)
  options[:branchName] || ENV['BRANCH_NAME'] || "dev"
end

# Bundle id iOS. env file có cả APP_ID (package name Android, vd com.coop_use)
# và APP_IOS_ID (com.coopuse) — lane iOS phải dùng đúng cái sau, nếu không
# pilot/latest_testflight_build_number sẽ trỏ vào app không tồn tại trên
# App Store Connect. Fail ngay ở đây thay vì sau khi pod install xong.
def resolve_ios_app_id
  app_id = ENV['APP_IOS_ID']
  UI.user_error!("Thiếu APP_IOS_ID trong env file — không xác định được bundle id iOS.") if app_id.nil? || app_id.to_s.empty?
  app_id.to_s
end

# App Store Connect API key: dùng file .p8 có sẵn trong ios/, nếu không có thì
# ghi ra từ secret base64 APP_STORE_CONNECT_API_KEY_BASE64. Trả về absolute path
# vì xcodebuild -authenticationKeyPath không nhận đường dẫn tương đối.
PEM_PRIVATE_KEY_HEADER = '-----BEGIN PRIVATE KEY-----'

# 12 ký tự đầu của SHA-256. Không đảo ngược được nên GitHub không che, dùng để
# so giá trị trên runner với máy local mà không in giá trị thật ra log.
def fingerprint(value)
  Digest::SHA256.hexdigest(value.to_s)[0, 12]
end

def resolve_api_key_path
  # GitHub secret rất dễ mang theo newline/space ở cuối khi paste vào UI. Một
  # `kid` hay `iss` có ký tự thừa vẫn tạo được JWT nhưng Apple sẽ từ chối với
  # "Authentication credentials are missing or invalid" — lỗi không chỉ ra được
  # cái gì sai. Strip trước, ghi lại vào ENV để provisioning_xcargs dùng bản sạch.
  key_id = ENV['KEY_ID'].to_s.strip
  issuer_id = ENV['ISSUER_ID'].to_s.strip

  if key_id.empty?
    # Máy local thường đã có sẵn AuthKey_<KEY_ID>.p8 trong ios/ — suy ra key id
    # từ tên file thay vì bắt lập trình viên export thêm biến môi trường.
    existing = Dir.glob("#{IOS_DIR}/AuthKey_*.p8").first
    UI.user_error!("Thiếu KEY_ID (App Store Connect API key id).") if existing.nil?
    key_id = File.basename(existing, '.p8').sub('AuthKey_', '')
    UI.message("Suy ra KEY_ID=#{key_id} từ #{existing}")
  end

  # Kiểm tra hình dạng: KEY_ID là 10 ký tự chữ-số, ISSUER_ID là UUID.
  unless key_id.match?(/\A[A-Z0-9]{10}\z/i)
    UI.user_error!("KEY_ID sai định dạng (#{key_id.length} ký tự) — phải là 10 ký tự chữ/số, lấy ở App Store Connect > Users and Access > Integrations.")
  end
  unless issuer_id.match?(/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/i)
    hint = issuer_id.empty? ? "đang rỗng" : "#{issuer_id.length} ký tự"
    UI.user_error!("ISSUER_ID sai định dạng (#{hint}) — phải là UUID dạng xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx, nằm ngay phía trên danh sách key ở trang Integrations.")
  end

  ENV['KEY_ID'] = key_id
  ENV['ISSUER_ID'] = issuer_id

  copy_local_secret(File.join(LOCAL_SECRETS_DIR, "AuthKey_#{key_id}.p8"), "#{IOS_DIR}/AuthKey_#{key_id}.p8")

  preferred = File.join(IOS_DIR, "AuthKey_#{key_id}.p8")
  unless File.exist?(preferred)
    key_base64 = ENV['APP_STORE_CONNECT_API_KEY_BASE64'].to_s.strip
    if key_base64.empty?
      UI.user_error!("Không tìm thấy AuthKey_#{key_id}.p8 trong ios/ và secret APP_STORE_CONNECT_API_KEY_BASE64 cũng rỗng.")
    end

    File.binwrite(preferred, decode_api_key(key_base64))
    File.chmod(0600, preferred)
    UI.message("Đã ghi App Store Connect API key ra #{preferred}")
  end

  # GitHub Actions che mọi giá trị secret trong log thành ***, kể cả khi nó nằm
  # trong tên file (AuthKey_***.p8) — bình thường, không phải lỗi. Hệ quả là
  # không thể nhìn log để biết giá trị trên runner có trùng máy local không.
  #
  # Hash thì không bị che. Đối chiếu 3 dòng dưới với local:
  #   printf '%s' "$KEY_ID"    | shasum -a 256 | cut -c1-12
  #   printf '%s' "$ISSUER_ID" | shasum -a 256 | cut -c1-12
  #   shasum -a 256 ios/AuthKey_<KEY_ID>.p8   | cut -c1-12
  # Cái nào lệch chính là secret bị sai. (KEY_ID/ISSUER_ID là định danh nằm sẵn
  # trong header/payload của JWT gửi lên Apple, không phải bí mật như .p8.)
  UI.message("fp KEY_ID    = #{fingerprint(key_id)}")
  UI.message("fp ISSUER_ID = #{fingerprint(issuer_id)}")
  UI.message("fp AuthKey   = #{Digest::SHA256.file(preferred).hexdigest[0, 12]} (#{File.size(preferred)} bytes)")
  preferred
end

# Trả về nội dung .p8. Nhận cả base64 của file lẫn nội dung PEM dán thẳng vào
# secret (nhầm lẫn phổ biến). Base64.decode64 im lặng bỏ qua ký tự không hợp lệ,
# nên không kiểm tra thì secret sai sẽ thành file rác và lỗi chỉ lộ ra ở phía
# Apple dưới dạng "Authentication credentials are missing or invalid".
def decode_api_key(raw)
  return raw if raw.start_with?(PEM_PRIVATE_KEY_HEADER)

  decoded = Base64.decode64(raw)
  unless decoded.start_with?(PEM_PRIVATE_KEY_HEADER)
    UI.user_error!(
      "APP_STORE_CONNECT_API_KEY_BASE64 không giải ra private key hợp lệ " \
      "(thiếu '#{PEM_PRIVATE_KEY_HEADER}'). Tạo lại secret bằng:\n" \
      "  base64 -i AuthKey_<KEY_ID>.p8 | tr -d '\\n' | pbcopy"
    )
  end
  decoded
end

# Keychain tạm + certificate distribution cho runner CI.
def setup_signing
  return UI.message("Không phải CI — bỏ qua setup keychain.") unless is_ci

  setup_ci(force: true)

  cert_base64 = ENV['IOS_DIST_CERT_P12_BASE64']
  if cert_base64.nil? || cert_base64.empty?
    UI.important("IOS_DIST_CERT_P12_BASE64 chưa set — dựa vào -allowProvisioningUpdates để Xcode tự tạo cert/profile qua API key.")
    return
  end

  p12_path = File.join(IOS_DIR, "dist_certificate.p12")
  File.binwrite(p12_path, Base64.decode64(cert_base64))
  import_certificate(
    certificate_path: p12_path,
    certificate_password: ENV['IOS_DIST_CERT_PASSWORD'] || "",
    keychain_name: "fastlane_tmp_keychain",
    keychain_password: ""
  )
ensure
  File.delete(p12_path) if defined?(p12_path) && p12_path && File.exist?(p12_path)
end

# Cho phép xcodebuild tự tạo/tải provisioning profile bằng App Store Connect API
# key (automatic signing trên runner sạch không có profile nào sẵn).
def provisioning_xcargs(api_key_path)
  args = ["-allowProvisioningUpdates"]
  if api_key_path && File.exist?(api_key_path) && ENV['KEY_ID'] && ENV['ISSUER_ID']
    args << "-authenticationKeyPath #{api_key_path.shellescape}"
    args << "-authenticationKeyID #{ENV['KEY_ID']}"
    args << "-authenticationKeyIssuerID #{ENV['ISSUER_ID']}"
  end
  args.join(" ")
end

# Ghi output cho GitHub Actions (step upload-artifact đọc từ đây). Gọi ngay sau
# gym và TRƯỚC pilot: nếu upload TestFlight lỗi thì IPA vẫn còn trên disk và
# step upload-artifact vẫn lấy được thay vì mất trắng bản build.
def export_ipa_output(app_name)
  return unless ENV['GITHUB_OUTPUT']

  File.open(ENV['GITHUB_OUTPUT'], 'a') do |f|
    f.puts "ipa_path=ios/builds/#{app_name}"
    f.puts "ipa_name=#{File.basename(app_name, '.ipa')}"
  end
end

# Các target phải mang cùng version/build. Apple bắt CFBundleShortVersionString
# và CFBundleVersion của app extension trùng với host app, lệch là pilot reject
# với ITMS-90473 CFBundleVersion Mismatch.
VERSIONED_TARGETS = %w[CoopUse OneSignalNotificationService].freeze

# Ghi thẳng MARKETING_VERSION + CURRENT_PROJECT_VERSION vào build settings của
# từng target, thay cho increment_version_number/increment_build_number.
#
# Lý do không dùng 2 action kia:
#   - chúng chạy qua agvtool, vốn theo project chứ không theo target, nên không
#     nhận tham số `target` (options chỉ có version_number/build_number/xcodeproj)
#   - agvtool đòi VERSIONING_SYSTEM = apple-generic, mà target
#     OneSignalNotificationService không có → build number của extension đứng yên
#     trong khi app nhảy lên, đúng vào lỗi ITMS-90473 nói trên
#   - `agvtool new-version -all` còn ghi số literal đè lên Info.plist, phá mất
#     $(CURRENT_PROJECT_VERSION) mà CoopUse/Info.plist đang tham chiếu
#
# Info.plist của cả 2 target đều lấy version từ build setting (CoopUse qua
# $(MARKETING_VERSION)/$(CURRENT_PROJECT_VERSION), extension qua
# GENERATE_INFOPLIST_FILE), nên set ở đây là đủ cho cả hai.
def set_project_version(version_number:, build_number:)
  project_path = "#{IOS_DIR}/CoopUse.xcodeproj"
  project = Xcodeproj::Project.open(project_path)

  VERSIONED_TARGETS.each do |target_name|
    target = project.targets.find { |t| t.name == target_name }
    UI.user_error!("❌ Target '#{target_name}' not found in #{project_path}") if target.nil?

    target.build_configurations.each do |config|
      config.build_settings['MARKETING_VERSION'] = version_number.to_s
      config.build_settings['CURRENT_PROJECT_VERSION'] = build_number.to_s
    end
    UI.message("🔧 #{target_name}: MARKETING_VERSION=#{version_number}, CURRENT_PROJECT_VERSION=#{build_number}")
  end

  project.save
  UI.success("✅ Đã set version #{version_number} (build #{build_number}) cho: #{VERSIONED_TARGETS.join(', ')}")
end

def update_target_bundle_id(target_name:, plist_path:, bundle_id:)
  require 'xcodeproj'

  project_path = "#{IOS_DIR}/CoopUse.xcodeproj"

  puts "🔧 Updating target '#{target_name}' with bundle ID '#{bundle_id}'"

  # Open Xcode project
  project = Xcodeproj::Project.open(project_path)
  target = project.targets.find { |t| t.name == target_name }

  if target.nil?
    UI.user_error!("❌ Target '#{target_name}' not found in #{project_path}")
  end

  # Update build settings
  target.build_configurations.each do |config|
    config.build_settings['PRODUCT_BUNDLE_IDENTIFIER'] = bundle_id
  end

  project.save
  UI.success("✅ Updated PRODUCT_BUNDLE_IDENTIFIER for target '#{target_name}'")

  # Optionally update Info.plist too
  update_info_plist(
    plist_path: plist_path,
    app_identifier: bundle_id
  )
end


def prepare_package(options)
  # nvm chỉ tồn tại trên máy local; trên runner Node đã do actions/setup-node lo.
  nvm_bin = "#{ENV["HOME"]}/.nvm/versions/node/v20.9.0/bin"
  ENV["PATH"] = "#{nvm_bin}:/usr/local/bin:#{ENV["PATH"]}" if Dir.exist?(nvm_bin)

  copy_local_secret(File.join(LOCAL_SECRETS_DIR, 'CoopUse', 'yarn.lock'), "#{REPO_ROOT}/yarn.lock")
  versionCode = resolve_version_number(options)
  # Version/build được set một lần bằng set_project_version trong lane, sau khi
  # đã biết build number từ TestFlight. Không set ở đây: pod install không đọc
  # MARKETING_VERSION nên không có lý do gì phải ghi project file sớm.

  # CI đã chạy `yarn install` ở step riêng (có cache) — không cài lại.
  sh "cd #{REPO_ROOT.shellescape} && yarn install --no-immutable" unless is_ci
  # cocoapods(
  #   clean_install: true,
  #   podfile: "./Podfile",
  #   silent: true,
  #   try_repo_update_on_error: true,
  # )
  # `sh` chạy trong ios/fastlane nên phải về repo root cho tường minh.
  sh "cd #{REPO_ROOT.shellescape} && yarn pod"

  FileUtils.rm_f("#{IOS_DIR}/.xcode.env.local")
  return versionCode
end


# Thông báo build lên Slack — giữ nguyên hình dạng của
# android/fastlane/Fastfile#postNotifyMessage để 2 platform bắn vào cùng một
# channel với cùng format, chỉ khác giá trị "Platform".
# Không set SLACK_WEBHOOK_URL thì bỏ qua im lặng (build local không cần bắn).
def postNotifyMessage(type, branch_name, version_num, build_num = 0)
  slack_url = ENV['SLACK_WEBHOOK_URL']
  if slack_url.nil? || slack_url.empty?
    UI.important("SLACK_WEBHOOK_URL chưa được set — bỏ qua thông báo Slack.")
    return
  end

  base_payload = { "Platform" => "iOS" }
  base_payload["Branch"] = branch_name unless branch_name.nil?
  base_payload["Version"] = version_num unless version_num.nil?
  base_payload["Build Number"] = build_num unless build_num.nil?

  case type
  when "start"
    slack(
      message: "🚧 Start building App",
      slack_url: slack_url,
      success: true,
      payload: base_payload
    )
  when "success"
    slack(
      message: "🎉 Build App Successfully!",
      slack_url: slack_url,
      success: true,
      payload: base_payload
    )
  when "error"
    slack(
      message: "❌ Build App Failed!",
      slack_url: slack_url,
      success: false,
      payload: base_payload
    )
  else
    UI.error("postNotifyMessage: unknown type '#{type}'")
  end
end
