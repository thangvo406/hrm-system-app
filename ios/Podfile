# Resolve react_native_pods.rb with node to allow for hoisting
# require Pod::Executable.execute_command('node', ['-p',
#   'require.resolve(
#     "react-native/scripts/react_native_pods.rb",
#     {paths: [process.argv[1]]},
#   )', __dir__]).strip
def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
end
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')
# SSZipArchive (pulled in by react-native-zip-archive) ships podspecs with an
# iOS 15.5 deployment target, above RN 0.81's min_ios_version_supported (15.1),
# so the platform is pinned here instead of inherited. Keep this in sync with
# IPHONEOS_DEPLOYMENT_TARGET in CoopUse.xcodeproj.
MIN_IOS_VERSION = '15.5'
platform :ios, MIN_IOS_VERSION
prepare_react_native_project!

# ios/.env and ios/tmp.xcconfig are GENERATED, gitignored, and never edited by
# hand. This one script produces both and is the only place that decides which
# source env (env/.dev | env/.prod) wins; see its header for the full contract.
GENERATE_ENV_SCRIPT = 'scripts/generate-ios-env.sh'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end
setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
])
target 'CoopUse' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end

    # Patch fmt base.h: disable consteval on all Apple Clang (broken on Xcode 26+)
    fmt_base_h = "#{installer.sandbox.root}/fmt/include/fmt/base.h"
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      patched = content.gsub(
        /#elif defined\(__apple_build_version__\) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0.*\n/,
        "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval broken on Apple Clang\n"
      )
      File.write(fmt_base_h, patched) if patched != content
    end

    # Generate ios/.env + ios/tmp.xcconfig now, so a freshly installed checkout
    # has them before the first build.
    require 'pathname'
    repo_root = Pathname.new(__dir__).join('..').expand_path
    system(repo_root.join(GENERATE_ENV_SCRIPT).to_s) ||
      Pod::UI.warn("#{GENERATE_ENV_SCRIPT} failed — ios/tmp.xcconfig may be stale")


    include_line = '#include? "../../../tmp.xcconfig"'
    env_consuming_targets = ['Pods-CoopUse', 'Pods-OneSignalNotificationService']
    installer.pods_project.targets.each do |target|
      next unless env_consuming_targets.include?(target.name)
      target.build_configurations.each do |config|
        xcconfig_path = config.base_configuration_reference.real_path
        contents = File.read(xcconfig_path)
        next if contents.include?(include_line)
        File.open(xcconfig_path, 'a') do |f|
          f.puts ''
          f.puts '// Generated env values, refreshed on every build'
          f.puts include_line
        end
      end
    end

    # Rewrite react-native-config's "Config codegen" phase so every build
    # regenerates ios/.env first, then feeds that file to BuildDotenvConfig.rb.
    # Without this the phase would read /tmp/envfile directly and ios/.env
    # would just be a file nothing consumes.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-config'
      phase = target.shell_script_build_phases.find do |p|
        p.name.to_s.include?('Config codegen')
      end
      next if phase.nil?
      phase.shell_script = <<~SH
        set -e
        HOST_PATH="$SRCROOT/../.."

        # Refreshes ios/.env and points /tmp/envfile at it. Note this only
        # keeps GeneratedDotEnv.m (the JS values) current — Info.plist reads
        # tmp.xcconfig, which Xcode has already loaded by the time build
        # phases run, so that one is regenerated by the scheme pre-action.
        "$HOST_PATH/#{GENERATE_ENV_SCRIPT}"

        "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig/BuildDotenvConfig.rb" "$HOST_PATH" "${PODS_TARGET_SRCROOT}/ios/ReactNativeConfig"
      SH
    end
  end
end
target 'OneSignalNotificationService' do
  # Must match the exact version react-native-onesignal depends on, otherwise
  # this target resolves to the newest 5.x and CocoaPods fails with
  # "could not find compatible versions for pod OneSignalXCFramework".
  pod 'OneSignalXCFramework', '5.2.10'
end
