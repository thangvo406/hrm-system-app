# Resolve react_native_pods.rb with node to allow for hoisting
# require Pod::Executable.execute_command('node', ['-p',
#   'require.resolve(
#     "react-native/scripts/react_native_pods.rb",
#     {paths: [process.argv[1]]},
#   )', __dir__]).strip
def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
end
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')
platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end
setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
])
target 'CoopUse' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end

    # Patch fmt base.h: disable consteval on all Apple Clang (broken on Xcode 26+)
    fmt_base_h = "#{installer.sandbox.root}/fmt/include/fmt/base.h"
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      patched = content.gsub(
        /#elif defined\(__apple_build_version__\) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0.*\n/,
        "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval broken on Apple Clang\n"
      )
      File.write(fmt_base_h, patched) if patched != content
    end

    # Inject env/.dev variables into Pods-CoopUse xcconfig so Xcode can
    # resolve things like $(APP_IOS_ID) and $(GOOGLE_IOS_CLIENT_ID) at
    # build time (in PRODUCT_BUNDLE_IDENTIFIER, Info.plist URL schemes, etc).
    require 'pathname'
    env_file = Pathname.new(__dir__).join('..', 'env', '.dev')
    if env_file.exist?
      env_lines = env_file.readlines.map(&:strip).reject do |l|
        l.empty? || l.start_with?('#')
      end
      installer.pods_project.targets.each do |target|
        next unless target.name == 'Pods-CoopUse'
        target.build_configurations.each do |config|
          xcconfig_path = config.base_configuration_reference.real_path
          contents = File.read(xcconfig_path)
          env_lines.each do |line|
            key, _ = line.split('=', 2)
            contents.gsub!(/^#{Regexp.escape(key)}=.*\n/, '')
          end
          File.open(xcconfig_path, 'a') do |f|
            f.puts ''
            f.puts '// Injected from env/.dev by Podfile post_install'
            env_lines.each { |line| f.puts line }
          end
        end
      end
    end
  end
end
