<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item
      name="android:editTextBackground"
    >@drawable/rn_edit_text_material</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Theme của MainActivity (launcher). Kế thừa AppTheme để giữ nguyên
         hành vi app, chỉ thêm windowBackground trùng nền launch_screen.xml
         nên cold start không nháy màu trước khi splash của
         react-native-splash-screen được gắn vào. -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Splash nền xanh đậm nên icon status bar phải sáng, ngược với
             AppTheme (nền sáng). MainActivity tự set lại lúc runtime. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
