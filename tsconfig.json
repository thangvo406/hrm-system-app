{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["react-native", "jest", "node"],
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@components": ["./src/components"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@screens": ["./src/screens"],
      "@screens/*": ["./src/screens/*"],
      "@services/*": ["./src/services/*"],
      "@translations": ["./src/translations"],
      "@translations/*": ["./src/translations/*"],
      "@tests/*": ["./src/tests/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@kits/*": ["./kits/*"]
    },
    "noUnusedLocals": true
  },
  "include": [
    "src/tests/**/*",
    "./src/**/*",
    "index.d.ts",
    "*.mjs",
    ".*.mjs",
    "*.js",
    ".*.js",
    "*.ts",
    ".prettierrc.mjs"
  ],
  "exclude": ["**/node_modules", "_", "android", "ios", "**/Pods"]
}
